# Copy to /opt/expensemanager/expensemanager.env and fill in real secrets.
# Generate strong values, e.g.:  openssl rand -hex 32

EXPENSE_ADDR=127.0.0.1:8080
EXPENSE_DB=/opt/expensemanager/expenses.db
EXPENSE_PASSWORD=change-me-to-a-strong-password
EXPENSE_BEARER_TOKEN=change-me-openssl-rand-hex-32
SESSION_SECRET=change-me-openssl-rand-hex-32
